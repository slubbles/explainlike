# Copy to .env and fill in. Never commit .env. Keys stay on the server: nothing here is sent to the browser.
# Tagged required vs optional. Required keys are only needed to make videos or turn sign-in on;
# the app boots and serves pages with an empty .env.
# No values below: secrets stay empty, numbers show their defaults.

# --- keys (optional to boot; one of the two Muse keys is required to make videos) ---
# Optional: OpenRouter key. When set, planning and voice chat use Muse Spark 1.3 through OpenRouter.
OPENROUTER_API_KEY=
# Optional: Meta Model API key. Used for Muse Spark when there is no OpenRouter key, and always for doodle icons and the voiceover check.
MODEL_API_KEY=
# Optional: pick the Muse Spark provider by hand, "openrouter" or "meta". Default: OpenRouter when its key is set, else Meta.
# EXPLANIMATE_LLM_PROVIDER=
# Optional: a different model id on that provider. Default: meta/muse-spark-1.3 on OpenRouter, muse-spark-1.3-contributor on Meta.
# EXPLANIMATE_SPARK_MODEL=
# Optional: override the chat API address (tests and proxies). Defaults: https://openrouter.ai/api/v1 and https://api.meta.ai/v1.
# OPENROUTER_API_BASE=
# META_API_BASE=
# Optional: copies of each long scene-plan and narration call sent side by side, first answer kept. Default 2; 1 turns it off.
# EXPLANIMATE_HEDGE=2
# Optional: Deepgram key for the Aura voiceover, word timestamps and voice mode. Without it, videos render silent with timed captions.
DEEPGRAM_API_KEY=
# Optional: Cartesia key. When set, a scene Deepgram fails to voice is voiced by Cartesia Sonic instead.
CARTESIA_API_KEY=
# Optional: Cartesia voice UUID and model. Defaults: a stock English voice and sonic-3.6.
# CARTESIA_VOICE_ID=
# CARTESIA_MODEL=sonic-3.6
# Optional: Deepgram video voice, chat voice and speech-to-text model. Defaults: aura-2-arcas-en, aura-2-thalia-en, nova-3.
# EXPLANIMATE_VOICE=
# EXPLANIMATE_CHAT_VOICE=
# EXPLANIMATE_STT=

# Old EXPLAINLIKE_* names (from before the rename) still work; an EXPLANIMATE_* name wins if both are set.
# Folders from before the rename (explainlike-out, ~/explainlike-videos, ~/.cache/explainlike)
# are likewise still used when the new ones do not exist.

# --- spend guard (web app; all optional) ---
# Optional: lifetime caps that pause new work before Muse or Deepgram spend could cross them. Defaults 25 and 10.
EXPLANIMATE_META_CAP_USD=25
EXPLANIMATE_VOICE_CAP_USD=10
# Optional: room kept free for one more job. Defaults 1 and 0.15.
EXPLANIMATE_META_RESERVE_USD=1
EXPLANIMATE_VOICE_RESERVE_USD=0.15
# Optional: combined Meta + voice cap for one UTC day. Default 3.
EXPLANIMATE_DAILY_CAP_USD=3

# --- limits (web app; all optional) ---
# Optional: requests per minute per IP for routes that start work or cost money. Default 12.
EXPLANIMATE_REQ_PER_MIN=12
# Optional: videos per hour across everyone. Default 20.
EXPLANIMATE_JOBS_PER_HOUR=20
# Optional: trust X-Forwarded-For for the client IP. Default 0; set to 1 only behind a proxy you run.
EXPLANIMATE_TRUST_PROXY=0
# Optional: videos running their API-bound stages (LLM planning, TTS, fetches) at once. Default 10.
# API_CONCURRENCY=10
# Optional: EXPLANIMATE_API_CONCURRENCY wins when both are set; JOB_CONCURRENCY, EXPLANIMATE_MAX_CONCURRENT and EXPLANIMATE_CONCURRENCY still work as aliases.
# Optional: videos rendering or encoding at once (the CPU-heavy stage). Default max(1, cpus - 2).
# RENDER_CONCURRENCY=2
# Optional: ffmpeg threads per render. Default cores divided by render slots, at least one.
# EXPLANIMATE_FFMPEG_THREADS=2
# Scenes voiced at once inside one video (1 to 16, default 8).
# SCENE_CONCURRENCY=8
# EXPLANIMATE_SCENE_CONCURRENCY wins when both are set.
# Calls to one paid provider running at once (Muse Spark on OpenRouter or Meta, Deepgram, Cartesia).
# A 429 parks that provider briefly with backoff; retries and provider fallbacks are unchanged.
# EXPLANIMATE_PROVIDER_CONCURRENCY=4
# EXPLANIMATE_RATE_LIMIT_DEEPGRAM=8
# Optional: safety ceiling on videos waiting for an API slot; only past this is a request refused. Default 200.
EXPLANIMATE_QUEUE_MAX=200
# Optional: seconds a waiting video is kept after its page stops polling. Default 120.
EXPLANIMATE_WAIT_IDLE_S=120
# Optional: show finished example videos only and refuse new ones. Default 0.
EXPLANIMATE_DEMO_ONLY=0
# Optional: restart a job a crash or restart cut off. Default 1; 0 turns it off.
EXPLANIMATE_RESUME=1
# Optional: read links that resolve to private or localhost addresses. Default 0; 1 only for a local intranet.
# EXPLANIMATE_ALLOW_PRIVATE_URLS=0
# Optional: accept absolute folder paths on the server as inputs. Default 0; leave off in public.
# EXPLANIMATE_ALLOW_LOCAL=0

# --- sign-in by email code (optional; off unless EXPLANIMATE_AUTH_ENABLED is exactly 1) ---
# Optional: only the exact value 1 turns on sign-in, Turnstile and the per-account daily limit. Default 0.
EXPLANIMATE_AUTH_ENABLED=0
# Required in production when sign-in is on; in local dev a fixed dev secret is used with a warning.
BETTER_AUTH_SECRET=
# Optional: public base URL of the app; also the trusted origin. Default http://localhost:3000.
BETTER_AUTH_URL=
# Optional: Google sign-in client id and secret; when both are set the panel offers "Continue with Google".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Required in production when sign-in is on with D1; in local dev sign-in uses a SQLite file (see EXPLANIMATE_D1_LOCAL_PATH).
EXPLANIMATE_CF_ACCOUNT_ID=
EXPLANIMATE_D1_DATABASE_ID=
EXPLANIMATE_D1_TOKEN=
# Required in production when sign-in is on; in local dev the code is logged to the server console instead of sent.
EXPLANIMATE_CF_EMAIL_TOKEN=
# Optional: sender line for login codes, "Name <addr>". Default Explanimate <login@explanimate.co>.
# EXPLANIMATE_EMAIL_FROM=
# Required in production when sign-in is on; in local dev a missing secret skips the check with a warning.
EXPLANIMATE_TURNSTILE_SITE_KEY=
EXPLANIMATE_TURNSTILE_SECRET=
EXPLANIMATE_TURNSTILE_HOSTNAMES=
# Optional: videos per account per UTC day. Default 3.
EXPLANIMATE_DAILY_VIDEOS=3
# Optional: local SQLite file instead of D1. Default in local dev when sign-in is on: <jobs dir>/auth.db.
# EXPLANIMATE_D1_LOCAL_PATH=
# Optional, tests only: folder where login codes are captured instead of sent.
# EXPLANIMATE_EMAIL_CAPTURE_DIR=
# Optional: comma list of admin addresses for the /admin portal. Empty: no admins.
# EXPLANIMATE_ADMIN_EMAILS=
# Optional: short alias for the above; the long name wins when both are set.
# ADMIN_EMAILS=
# Optional: Google Analytics 4 id (G-…). A server setting: the root layout reads it at
# request time and hands it to the browser, so it is never baked in at build time.
# Unset: nothing from Google loads.
# GA_MEASUREMENT_ID=

# --- ports (all optional) ---
# Optional: web app port. Default 3000.
# PORT=3000
# Optional: local job API port (packages/api). Default 7311.
# EXPLANIMATE_API_PORT=7311

# --- paths and timeouts (all optional) ---
# Optional: where web jobs are kept. Default: explanimate-out/web in the repo.
# EXPLANIMATE_JOBS_DIR=
# Optional: folder of example videos for the home page and /gallery. Unset or empty: no examples are shown.
# EXPLANIMATE_GALLERY_DIR=
# Optional: where the CLI's API server writes videos. Default: ~/explanimate-videos.
# EXPLANIMATE_OUT_DIR=
# Optional: repo root for resolving default folders. Default: two folders up from the web app.
# EXPLANIMATE_ROOT=
# Optional: CLI entry the web app spawns for renders. Default: packages/cli/bin/explanimate.mjs.
# EXPLANIMATE_CLI=
# Optional: Chrome or Chromium binary for rendering, if it is not in a standard place.
# EXPLANIMATE_CHROME=
# Optional: frame renderer, "skia" or "chrome". Default skia, with Chrome as the fallback.
# EXPLANIMATE_RENDERER=
# Optional: H.264 encoder, "nvenc" or "x264". Default: auto (NVENC when a GPU test encode works).
# EXPLANIMATE_ENCODER=
# Optional: seconds before a git clone gives up. Default 180.
# EXPLANIMATE_CLONE_TIMEOUT_S=180
# Optional: shared plan cache. Default on; 0 turns it off.
# EXPLANIMATE_PLAN_CACHE=
# Optional: cache folders. Defaults: ~/.cache/explanimate/plans, repos, icons and tts.
# EXPLANIMATE_PLAN_CACHE_DIR=
# EXPLANIMATE_REPO_CACHE=
# EXPLANIMATE_ICON_CACHE=
# EXPLANIMATE_TTS_CACHE=
# Optional: how long the MCP server waits per call, in seconds. Default 50 (max 600).
# EXPLANIMATE_MCP_WAIT_SEC=
# Optional: Node environment. Default unset (development under `next dev`, production under `next start`).
# NODE_ENV=
