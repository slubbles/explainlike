# Copy to .env and fill in. Never commit .env. Keys stay on the server: nothing here is sent to the browser.

# --- keys ---
# OpenRouter key (https://openrouter.ai/keys). When set, planning and the voice chat use Muse Spark 1.3
# through OpenRouter (meta/muse-spark-1.3). Set this or MODEL_API_KEY. Also the backup: when Meta is
# the provider and a call fails, it is tried once on OpenRouter.
OPENROUTER_API_KEY=
# Meta Model API key (https://dev.meta.ai). Used for Muse Spark when there is no OpenRouter key, and always
# for doodle icons (Muse Image, SAM) and the voiceover check (Muse Transcribe).
MODEL_API_KEY=
# Optional: pick the Muse Spark provider by hand, "openrouter" or "meta". Unset: OpenRouter when its key is set.
# EXPLANIMATE_LLM_PROVIDER=
# Optional: a different model id on that provider (default meta/muse-spark-1.3 on OpenRouter, muse-spark-1.3-contributor on Meta).
# EXPLANIMATE_SPARK_MODEL=
# Optional: copies of each long scene-plan and narration call sent side by side, first answer kept. 1 turns it off.
# EXPLANIMATE_HEDGE=2
# Optional: Deepgram key for the Aura voiceover, word timestamps and voice mode. Without it, videos render silent with timed captions.
DEEPGRAM_API_KEY=
# Optional: Cartesia key (https://play.cartesia.ai/keys). When set, a scene Deepgram fails to voice
# is voiced by Cartesia Sonic instead (a 24 kHz wav, word timings estimated at speaking pace).
CARTESIA_API_KEY=
# Optional: Cartesia voice and model. Any voice UUID from https://play.cartesia.ai/voices works.
# CARTESIA_VOICE_ID=
# CARTESIA_MODEL=sonic-3.6

# Old EXPLAINLIKE_* names (from before the rename) still work; an EXPLANIMATE_* name wins if both are set.
# Folders from before the rename (explainlike-out, ~/explainlike-videos, ~/.cache/explainlike)
# are likewise still used when the new ones do not exist.

# --- spend guard (web app) ---
# New jobs pause before a job could cross either cap; a warning shows past 80%. Spend is summed from every job on disk.
# The Meta cap counts all Muse spend, whether Muse Spark ran on OpenRouter or on Meta.
EXPLANIMATE_META_CAP_USD=25
EXPLANIMATE_VOICE_CAP_USD=10
# Room kept free for one more job (a fresh video costs about $0.15-0.30 Meta and $0.05-0.10 Deepgram).
EXPLANIMATE_META_RESERVE_USD=1
EXPLANIMATE_VOICE_RESERVE_USD=0.15
# Combined Meta + voice cap for one UTC day (works whether sign-in is on or off).
# New jobs pause past it until 00:00 UTC.
EXPLANIMATE_DAILY_CAP_USD=3

# --- limits (web app) ---
# Requests per minute per IP for routes that start work or cost money.
EXPLANIMATE_REQ_PER_MIN=12
# Videos per hour across everyone.
EXPLANIMATE_JOBS_PER_HOUR=20
# Set to 1 only behind a proxy you run that sets X-Forwarded-For; otherwise every caller shares one limit.
EXPLANIMATE_TRUST_PROXY=0
# Videos rendered at once. Past that, new videos wait their turn and their page shows the first step as starting soon.
# EXPLANIMATE_CONCURRENCY still works; EXPLANIMATE_MAX_CONCURRENT wins when both are set.
EXPLANIMATE_MAX_CONCURRENT=10
# Safety ceiling on videos waiting for a render slot; only past this is a request refused.
EXPLANIMATE_QUEUE_MAX=200
# Seconds a waiting video is kept after its page stops polling (the tab was closed).
EXPLANIMATE_WAIT_IDLE_S=120
# Set to 1 to only show finished example videos and refuse new ones.
EXPLANIMATE_DEMO_ONLY=0
# Set to 0 to stop the server from restarting a job a crash or restart cut off.
EXPLANIMATE_RESUME=1
# Links that resolve to localhost or private network addresses are refused everywhere.
# Set to 1 (or pass --allow-private to the CLI) only to read pages on a local intranet.
# EXPLANIMATE_ALLOW_PRIVATE_URLS=0

# --- sign-in by email code (off unless EXPLANIMATE_AUTH_ENABLED is exactly 1) ---
# Only the exact value 1 turns on sign-in, Turnstile and the per-account daily limit.
# Unset or anything else: no sign-in, existing per-IP limits and spend caps still apply.
# The landing page, gallery and /docs stay open without an account either way.
EXPLANIMATE_AUTH_ENABLED=0
# Random secret for session cookies (generate one with: openssl rand -base64 32).
BETTER_AUTH_SECRET=
# Public base URL of the app (https://explanimate.co in production); also the trusted origin.
BETTER_AUTH_URL=
# Cloudflare account id for D1 (the sign-in database) and Email (login codes).
EXPLANIMATE_CF_ACCOUNT_ID=
# D1 database id, and an API token with D1 read and write on it. Tables are created on first use.
EXPLANIMATE_D1_DATABASE_ID=
EXPLANIMATE_D1_TOKEN=
# API token allowed to send through Cloudflare Email Service.
EXPLANIMATE_CF_EMAIL_TOKEN=
# Sender line for login codes, "Name <addr>". Default: Explanimate <login@explanimate.co>.
# EXPLANIMATE_EMAIL_FROM=
# Turnstile site key (public, shown on the sign-in form) and secret, plus the hostnames
# a token must come from (comma list, e.g. explanimate.co,www.explanimate.co).
EXPLANIMATE_TURNSTILE_SITE_KEY=
EXPLANIMATE_TURNSTILE_SECRET=
EXPLANIMATE_TURNSTILE_HOSTNAMES=
# Videos per account per UTC day (a row in user_limits overrides it for one user).
EXPLANIMATE_DAILY_VIDEOS=3
# Comma list of admin addresses for the /admin portal (case-insensitive). Empty: no admins.
# EXPLANIMATE_ADMIN_EMAILS=
# Optional: Google Analytics 4 id (G-…). Unset: nothing from Google loads.
# GA_MEASUREMENT_ID=

# --- paths and timeouts (all optional) ---
# Where web jobs are kept. Default: explanimate-out/web in the repo.
# EXPLANIMATE_JOBS_DIR=
# Folder of example videos for the home page and /gallery: the mp4s, their posters and a gallery.json
# (see docs/gallery.example.json). Unset or empty: no examples are shown. Default in Docker: /data/gallery
# EXPLANIMATE_GALLERY_DIR=
# Where the CLI's API server writes videos. Default: ~/explanimate-videos
# EXPLANIMATE_OUT_DIR=
# Chrome or Chromium binary for rendering, if it is not in a standard place.
# EXPLANIMATE_CHROME=
# Seconds before a git clone gives up.
# EXPLANIMATE_CLONE_TIMEOUT_S=180
