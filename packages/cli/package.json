{
  "name": "explainlike",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Turn a GitHub repo, X post or article into a whiteboard explainer video + editable board (.tldr, opens in tldraw.com), powered by Meta Muse models.",
  "bin": {
    "explainlike": "./bin/explainlike.mjs"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@explainlike/core": "workspace:*",
    "@explainlike/models": "workspace:*",
    "@explainlike/ingest": "workspace:*",
    "@explainlike/planner": "workspace:*",
    "@explainlike/voice": "workspace:*",
    "@explainlike/render": "workspace:*",
    "tsx": "^4.19.2"
  }
}