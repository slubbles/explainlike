{
  "name": "explanimate",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Turn a GitHub repo, X post or article into a whiteboard explainer video + editable board (.tldr, opens in tldraw.com), powered by Meta Muse models.",
  "bin": {
    "explanimate": "./bin/explanimate.mjs"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@explanimate/core": "workspace:*",
    "@explanimate/models": "workspace:*",
    "@explanimate/ingest": "workspace:*",
    "@explanimate/planner": "workspace:*",
    "@explanimate/voice": "workspace:*",
    "@explanimate/render": "workspace:*",
    "tsx": "^4.19.2"
  }
}