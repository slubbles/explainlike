  "scale": [
    {
      "component": "d1-db",
      "at": "10x",
      "problem": "d1 read overload",
      "why": "Catalog GET loads all hosted-clip rows from D1 on every feed open, so concurrent users spike reads and Worker CPU.",
      "fix": "snapshot cache",
      "fix_detail": "Cache listPublicCatalogHostedClips in KV / FYP snapshots with pagination instead of full scan per request.",
      "evidence": "app/api/hosted-clips/route.ts"
    },
    {
      "component": "chat-live-do",
      "at": "100x",
      "problem": "single room fanout",
      "why": "All shards hear same broadcasts and one hibernatable DO fans out to every socket, exhausting isolate memory and CPU.",
      "fix": "shard rooms",
      "fix_detail": "Split ChatLive by CHAT_LIVE_SHARDS with sticky routing and cross-shard gossip to bound per-isolate sockets.",
      "evidence": "lib/chat-live-do.ts"
    },
    {
      "component": "clips-cdn",
      "at": "100x",
      "problem": "purge rate limits",
      "why": "One-year immutable cache means every delete needs Cloudflare prefix purge via CLOUDFLARE_API_TOKEN, which throttles and stalls.",
      "fix": "versioned keys",
      "fix_detail": "Never overwrite R2 keys; write content-hashed keys with ?v= busters so deletes need no Cloudflare prefix purge.",
      "evidence": "lib/clip-cdn-purge.ts"
    }
  ]
